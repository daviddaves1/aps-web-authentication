@startuml contexto
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam defaultFontSize 12
skinparam roundCorner 14
skinparam shadowing false
skinparam ArrowColor #334155
skinparam ArrowFontColor #0F172A
skinparam ArrowFontSize 12
skinparam nodesep 90
skinparam ranksep 80

skinparam rectangle {
    FontColor #0F172A
}

skinparam database {
    FontColor #0F172A
}

title <b>Diagrama C4 — Nível 1: Contexto do Sistema</b>

rectangle "<b>Usuário</b>\n<color:#475569>[Pessoa / Ator Externo]</color>\n\nTitular das credenciais que\ninforma seus dados para acesso." as usuario #F8FAFC;line:475569;line.bold

rectangle "<b>Aplicação Cliente</b>\n<color:#475569>[Sistema Externo Consumidor]</color>\n\nColeta as credenciais do usuário,\nsolicita a autenticação e conduz o fluxo\nconforme o resultado retornado." as app_cliente #F8FAFC;line:475569;line.bold

package "Fronteira do Sistema em Análise" as boundary #F0F9FF;line:0284C7;line.dashed {
    rectangle "<b>Serviço de Autenticação Web</b>\n<color:#0369A1>[Sistema de Software — Escopo da APS]</color>\n\nRecebe credenciais, consulta o usuário,\nverifica a senha utilizando o hash armazenado\ne retorna o resultado da autenticação." as servico_auth #E0F2FE;line:0284C7;line.bold
}

database "<b>Base de Usuários</b>\n<color:#475569>[Sistema Externo Preexistente]</color>\n\nRepositório externo contendo os registros\nde usuários e hashes armazenados,\nconsultado sem gerência por este serviço." as base_usuarios #F8FAFC;line:475569;line.bold

usuario -left-> app_cliente : "Informa credenciais"

app_cliente -down-> servico_auth : "Solicita autenticação"
servico_auth -up-> app_cliente : "Retorna identificação do usuário\nou mensagem de erro"

servico_auth -down-> base_usuarios : "Consulta registro e\nrecupera hash"

@enduml